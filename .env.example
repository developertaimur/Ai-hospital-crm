# Demo credentials for Life Care International Hospital CRM
# Copy this file to `.env` and adjust values locally.
# These are DEMO-ONLY values — not production secrets.
# NEXT_PUBLIC_ vars are embedded in the client bundle; do not use real passwords here.

# Admin
NEXT_PUBLIC_DEMO_ADMIN_USERNAME=admin
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123

# Doctor A — Dr. Muhammad Taimur
NEXT_PUBLIC_DEMO_DOCTOR_AHMED_USERNAME=doctor.taimur
NEXT_PUBLIC_DEMO_DOCTOR_AHMED_PASSWORD=doctor123

